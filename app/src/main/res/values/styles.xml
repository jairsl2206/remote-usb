<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF101418</color>
    <color name="panel">#FF1C232B</color>
    <color name="accent">#FF00B4D8</color>
    <color name="text">#FFE8EEF2</color>
    <color name="muted">#FF9AA7B2</color>

    <style name="TvButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
